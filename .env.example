# Maanmittauslaitoksen avoin API-avain (ilmainen: https://omatili.maanmittauslaitos.fi/)
# Jätä tyhjäksi, jos haluat käyttää avoimia globaaleja ESRI/OSM-karttoja kehityksessä.
# Avain pysyy palvelinpuolen proxyssa (vite.config.ts / tuotannossa Cloudflare Worker),
# eikä sitä koskaan sisällytetä selaimen JavaScript-koodiin.
MML_API_KEY=

# Valinnainen: PostHog EU -analytiikka & ruutunauhoitus betatestaukseen (latautuu vain jos käyttäjä hyväksyy beta-palkissa)
# Hae Project API Key: https://eu.posthog.com -> Settings -> Project -> Project API Key (phc_...)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
